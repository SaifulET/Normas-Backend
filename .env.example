PORT=5001
NODE_ENV=development
MONGODB_URI=your_mongodb_connection_string

ACCESS_TOKEN_SECRET=your_access_token_secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_EXPIRES_IN=7d

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

OTP_EXPIRES_IN_MINUTES=10
CLIENT_URL=http://localhost:3000

STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_pricing_webhook_secret
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=whsec_your_subscription_webhook_secret

AWS_REGION=your_aws_region
AWS_BUCKET_NAME=your_s3_bucket_name
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

KYC_MAX_FILE_SIZE_MB=50
NOTIFICATION_REMINDER_POLL_MS=60000
NOTIFICATION_DUE_LOOKBACK_MS=86400000
